{
  "formSchema": {
    "sections": [
      {
        "id": "meta",
        "title": "サイト基本設定",
        "icon": "🌐",
        "fields": [
          { "id": "siteTitle", "type": "text", "label": "サイトタイトル", "required": true },
          { "id": "siteName", "type": "text", "label": "サークル名・ブランド名" },
          { "id": "siteUrl", "type": "text", "label": "サイトURL (https://...)" },
          { "id": "seoDescription", "type": "textarea", "label": "サイトの説明 (SEO/SNS用)" },
          { "id": "ogpImage", "type": "image", "label": "OGP画像", "description": "推奨 1200x630" }
        ]
      },
      {
        "id": "design",
        "title": "デザイン設定",
        "icon": "🎨",
        "description": "作品の世界観に合わせて調整してください",
        "fields": [
          { "id": "primaryColor", "type": "color", "label": "背景色", "default": "#fcfcfc" },
          { "id": "secondaryColor", "type": "color", "label": "メイン文字色", "default": "#2d2d2d" },
          { "id": "accentColor", "type": "color", "label": "アクセントカラー (赤など)", "default": "#a62c2c" },
          { "id": "heroImage", "type": "image", "label": "ヒーロー画像 (背景)" },
          { "id": "heroPositionX", "type": "slider", "label": "背景位置（横）", "min": 0, "max": 100, "unit": "%", "default": 50 },
          { "id": "heroPositionY", "type": "slider", "label": "背景位置（縦）", "min": 0, "max": 100, "unit": "%", "default": 50 },
          { "id": "heroPositionX_mobile", "type": "slider", "label": "背景位置（横・モバイル）", "min": 0, "max": 100, "unit": "%", "default": 50 },
          { "id": "heroPositionY_mobile", "type": "slider", "label": "背景位置（縦・モバイル）", "min": 0, "max": 100, "unit": "%", "default": 25 },
          { "id": "overlayColor", "type": "color", "label": "オーバーレイ色", "default": "#ffffff" },
          { "id": "overlayOpacity", "type": "slider", "label": "オーバーレイ濃度", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 20 }
        ]
      },
      {
        "id": "hero",
        "title": "メインビジュアル",
        "icon": "🖼️",
        "fields": [
          { "id": "heroTitle", "type": "text", "label": "タイトルロゴ/文字" },
          { "id": "heroSubtitle", "type": "text", "label": "サブタイトル" }
        ]
      },
      {
        "id": "about",
        "title": "作品説明",
        "icon": "📝",
        "fields": [
          { "id": "aboutTitle", "type": "text", "label": "見出し", "default": "Introduction" },
          { "id": "aboutText", "type": "textarea", "label": "本文" }
        ]
      },
      {
        "id": "release",
        "title": "リリース情報",
        "icon": "💿",
        "fields": [
          { "id": "jacketImage", "type": "image", "label": "ジャケット画像" },
          { "id": "albumTitle", "type": "text", "label": "アルバム名", "required": true },
          { "id": "artistName", "type": "text", "label": "アーティスト名" },
          {
            "id": "releaseInfo",
            "type": "array",
            "label": "頒布情報",
            "itemTemplate": { "label": "Release", "value": "2025.12.31" }
          },
          {
            "id": "shopLinks",
            "type": "array",
            "label": "ショップリンク",
            "itemTemplate": { "label": "BOOTH", "url": "#" }
          }
        ]
      },
      {
        "id": "tracks",
        "title": "トラックリスト",
        "icon": "🎵",
        "fields": [
          {
            "id": "tracks",
            "type": "array",
            "label": "楽曲一覧",
            "itemTemplate": { "trackNumber": "01", "title": "曲名", "artist": "Composer", "duration": "4:00" }
          }
        ]
      },
      {
        "id": "credits",
        "title": "クレジット",
        "icon": "👥",
        "fields": [
          {
            "id": "credits",
            "type": "array",
            "label": "クレジット一覧",
            "itemTemplate": { "role": "Produce", "name": "Name", "link1Label": "Twitter", "link1Url": "#" }
          }
        ]
      },
      {
        "id": "footer",
        "title": "フッター",
        "icon": "🦶",
        "fields": [
          { "id": "footerLogo", "type": "image", "label": "フッターロゴ" },
          {
            "id": "footerLinks",
            "type": "array",
            "label": "フッターリンク",
            "itemTemplate": { "label": "Official Site", "url": "#" }
          },
          { "id": "footerCopyright", "type": "text", "label": "コピーライト", "default": "© katanegai project" }
        ]
      }
    ]
  }
}