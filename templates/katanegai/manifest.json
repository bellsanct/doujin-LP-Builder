{
  "id": "katanegai",
  "name": "片音がい",
  "version": "2.0.0",
  "author": "bellsanct",
  "description": "同人音楽作品向けのシンプルで美しいランディングページテンプレート",
  "thumbnail": "preview.png",
  "tags": ["music", "doujin", "minimal", "japanese"],
  "supportedBlocks": [
    "hero",
    "text",
    "heading",
    "image",
    "gallery",
    "tracklist",
    "credits",
    "shop-links",
    "button",
    "divider",
    "spacer"
  ],
  "defaultGlobalSettings": {
    "colors": {
      "primary": "#fcfcfc",
      "secondary": "#2d2d2d",
      "accent": "#a62c2c",
      "background": "#ffffff",
      "text": "#2d2d2d"
    },
    "typography": {
      "headingFont": "'Noto Sans JP', sans-serif",
      "bodyFont": "'Noto Sans JP', sans-serif",
      "baseSize": 16,
      "scale": 1.25
    },
    "layout": {
      "maxWidth": 1200,
      "gutter": 24
    },
    "cssVars": {
      "--hero-overlay-default": "#ffffff",
      "--transition-speed": "0.3s"
    }
  },
  "presets": [
    {
      "name": "デフォルト",
      "description": "標準的な音楽作品ランディングページ",
      "blocks": []
    }
  ]
}
